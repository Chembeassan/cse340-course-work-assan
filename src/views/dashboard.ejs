<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - CSE 340 Service Network</title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <%- include('partials/header') %>
    
    <main>
        <div class="container">
            <div class="page-header">
                <h1>Dashboard</h1>
                <p>Welcome to your personal dashboard</p>
            </div>
            
            <div class="dashboard-content">
                <div class="dashboard-card">
                    <h2>User Information</h2>
                    <div class="user-info">
                        <p><strong>Name:</strong> <%= name %></p>
                        <p><strong>Email:</strong> <%= email %></p>
                        <% if (role) { %>
                            <p><strong>Role:</strong> <span class="role-badge <%= role === 'admin' ? 'role-admin' : 'role-user' %>"><%= role %></span></p>
                        <% } %>
                    </div>
                </div>
                
                <!-- Admin-only actions -->
                <% if (role === 'admin') { %>
                    <div class="dashboard-card admin-actions">
                        <h2>Admin Actions</h2>
                        <div class="action-grid">
                            <a href="/users" class="action-card">
                                <span class="action-icon">👥</span>
                                <span class="action-label">Manage Users</span>
                            </a>
                            <a href="/organizations" class="action-card">
                                <span class="action-icon">🏢</span>
                                <span class="action-label">View Organizations</span>
                            </a>
                            <a href="/projects" class="action-card">
                                <span class="action-icon">📋</span>
                                <span class="action-label">View Projects</span>
                            </a>
                            <a href="/categories" class="action-card">
                                <span class="action-icon">🏷️</span>
                                <span class="action-label">View Categories</span>
                            </a>
                            <a href="/new-organization" class="action-card">
                                <span class="action-icon">➕</span>
                                <span class="action-label">Add Organization</span>
                            </a>
                            <a href="/new-project" class="action-card">
                                <span class="action-icon">➕</span>
                                <span class="action-label">Add Project</span>
                            </a>
                            <a href="/new-category" class="action-card">
                                <span class="action-icon">➕</span>
                                <span class="action-label">Add Category</span>
                            </a>
                        </div>
                    </div>
                <% } %>
                
                <div class="dashboard-actions">
                    <h3>Quick Actions</h3>
                    <div class="action-grid">
                        <a href="/organizations" class="action-card">
                            <span class="action-icon">🏢</span>
                            <span class="action-label">View Organizations</span>
                        </a>
                        <a href="/projects" class="action-card">
                            <span class="action-icon">📋</span>
                            <span class="action-label">View Projects</span>
                        </a>
                        <a href="/categories" class="action-card">
                            <span class="action-icon">🏷️</span>
                            <span class="action-label">View Categories</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>
    
    <%- include('partials/footer') %>
</body>
</html>