<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - CSE 340 Service Network</title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <%- include('partials/header') %>
    
    <main>
        <div class="container">
            <div class="page-header">
                <h1>Dashboard</h1>
                <p>Welcome to your personal dashboard</p>
            </div>
            
            <div class="dashboard-content">
                <div class="dashboard-card">
                    <h2>User Information</h2>
                    <div class="user-info">
                        <p><strong>Name:</strong> <%= name %></p>
                        <p><strong>Email:</strong> <%= email %></p>
                        <% if (role) { %>
                            <p><strong>Role:</strong> <span class="role-badge <%= role === 'admin' ? 'role-admin' : 'role-user' %>"><%= role %></span></p>
                        <% } %>
                    </div>
                </div>
                
                <!-- Volunteer Projects Section -->
                <div class="dashboard-card">
                    <h2>My Volunteer Projects</h2>
                    <% if (volunteerProjects && volunteerProjects.length > 0) { %>
                        <div class="volunteer-list">
                            <% volunteerProjects.forEach(project => { %>
                                <div class="volunteer-item">
                                    <div class="volunteer-project-info">
                                        <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
                                        <p><strong>Organization:</strong> <%= project.organization_name %></p>
                                        <p><strong>Location:</strong> <%= project.location %></p>
                                        <p><strong>Date:</strong> <%= new Date(project.project_date).toLocaleDateString() %></p>
                                        <p><small>Signed up: <%= new Date(project.volunteered_at).toLocaleDateString() %></small></p>
                                    </div>
                                    <div class="volunteer-actions">
                                        <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                                            <button type="submit" class="btn btn-danger btn-sm">Remove Me</button>
                                        </form>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p>You haven't signed up for any projects yet.</p>
                        <p><a href="/projects">Browse projects to volunteer for →</a></p>
                    <% } %>
                </div>
                
                <!-- Admin-only actions -->
                <% if (role === 'admin') { %>
                    <div class="dashboard-card admin-actions">
                        <h2>Admin Actions</h2>
                        <div class="action-grid">
                            <a href="/users" class="action-card">
                                <span class="action-icon">👥</span>
                                <span class="action-label">Manage Users</span>
                            </a>
                            <a href="/new-organization" class="action-card">
                                <span class="action-icon">➕</span>
                                <span class="action-label">Add Organization</span>
                            </a>
                            <a href="/new-project" class="action-card">
                                <span class="action-icon">➕</span>
                                <span class="action-label">Add Project</span>
                            </a>
                            <a href="/new-category" class="action-card">
                                <span class="action-icon">➕</span>
                                <span class="action-label">Add Category</span>
                            </a>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    </main>
    
    <%- include('partials/footer') %>
</body>
</html>