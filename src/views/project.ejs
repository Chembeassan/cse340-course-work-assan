<%- include('partials/header') %>

<main>
    <div class="container">
        <div class="project-header">
            <h1><%= project.title %></h1>
            <div class="project-actions">
                <% if (user && user.role_name === 'admin') { %>
                    <a href="/edit-project/<%= project.project_id %>" class="btn btn-edit">✏️ Edit Project</a>
                    <a href="/project/<%= project.project_id %>/assign-categories" class="btn btn-categories">
                        🏷️ Edit Categories
                    </a>
                <% } %>
            </div>
        </div>
        
        <div class="project-details">
            <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
            <p><strong>Date:</strong> <%= new Date(project.project_date).toLocaleDateString() %></p>
            <p><strong>Location:</strong> <%= project.location %></p>
            <p><strong>Volunteers:</strong> <%= volunteerCount || 0 %> signed up</p>
        </div>
        
        <div class="project-description">
            <h2>About This Project</h2>
            <p><%= project.description %></p>
        </div>
        
        <!-- Volunteer Section -->
        <div class="project-volunteer">
            <% if (user) { %>
                <% if (isVolunteer) { %>
                    <div class="volunteer-status volunteer-active">
                        <p>✅ You are signed up as a volunteer for this project!</p>
                        <form action="/project/<%= project.project_id %>/unvolunteer" method="POST" style="display: inline;">
                            <button type="submit" class="btn btn-danger">Remove Me</button>
                        </form>
                    </div>
                <% } else { %>
                    <div class="volunteer-status volunteer-inactive">
                        <p>Want to help? Sign up as a volunteer!</p>
                        <form action="/project/<%= project.project_id %>/volunteer" method="POST" style="display: inline;">
                            <button type="submit" class="btn btn-volunteer">🙋 Volunteer</button>
                        </form>
                    </div>
                <% } %>
            <% } else { %>
                <div class="volunteer-status volunteer-login">
                    <p><a href="/login">Log in</a> to sign up as a volunteer.</p>
                </div>
            <% } %>
        </div>
        
        <!-- Categories Section -->
        <% if (categories && categories.length > 0) { %>
            <div class="project-categories">
                <h2>Categories</h2>
                <div class="category-tags">
                    <% categories.forEach(category => { %>
                        <a href="/category/<%= category.category_id %>" class="category-tag">
                            <%= category.name %>
                        </a>
                    <% }) %>
                </div>
            </div>
        <% } %>
        
        <p><a href="/projects">← Back to All Projects</a></p>
    </div>
</main>

<%- include('partials/footer') %>